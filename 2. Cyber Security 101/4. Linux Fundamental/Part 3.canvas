		{"id":"546f0ebb883f834a","type":"text","text":"# Logs","x":936,"y":6161,"width":250,"height":60},
		{"id":"5fbb970962c02a6a","type":"text","text":"Located in the /var/log directory, these files and folders contain logging information for applications and services running on your system.","x":1340,"y":6141,"width":406,"height":100},
